cabal-version:      3.0
-- The package's name and version, like "name" and "version" in package.json.
name:               double-entry-ledger
version:            0.1.0.0
synopsis:           A small double-entry ledger API in Haskell
license:            MIT
build-type:         Simple
-- Files that aren't Haskell but are baked into the program at compile time
-- (see Ledger.Db), so they're included when the package is bundled up.
-- Each migration must also be added to the list in Ledger.Db.
extra-source-files: db/migrations/*.sql

-- A "common stanza" is a block of settings that other sections pull in with
-- "import: shared", so the same options aren't repeated three times.
common shared
  default-language: Haskell2010
  -- -Wall turns on (nearly) all warnings: missing cases, unused imports...
  ghc-options:      -Wall
  -- Packages every component needs, like "dependencies" in package.json.
  build-depends:
      base >=4.14 && <5
    , aeson >=2.0
    , bytestring
    , containers
    , mtl
    , stm
    , text
    , time

-- The library: all the real code, in src/. The executable and the tests
-- below both depend on it, so the logic is written once and shared.
library
  import:           shared
  hs-source-dirs:   src
  -- Every module must be listed here, or cabal silently won't compile it.
  exposed-modules:
      Ledger.App
      Ledger.Auth
      Ledger.Core
      Ledger.Db
      Ledger.Money
      Ledger.Seed
      Ledger.Session
      Ledger.Store
      Ledger.Store.Postgres
      Ledger.Throttle
      Ledger.Types
      Ledger.Validate
  build-depends:
      -- Reading and writing the session cookie.
      cookie
      -- Secure random tokens, SHA-256 and Argon2 (crypton), and its byte
      -- helpers (ram). Held at 1.1: crypton 2.x added ARM-specific SHA-3 C
      -- code that GCC on ARM Linux can't compile, which breaks the Docker
      -- build on Apple Silicon.
    , crypton >=1.1 && <1.2
    , file-embed
    , http-types
    -- Network addresses, for counting failed logins per client.
    , network
    , ram
    -- The Postgres driver (needs libpq, Postgres's C client library) and a
    -- connection pool.
    , postgresql-simple >=0.6 && <0.8
    , resource-pool >=0.4 && <0.6
    -- Pinned: Scotty 0.20+ changed its API, and this code targets 0.12.
    , scotty >=0.12 && <0.13
    , transformers
    , wai
    -- Ready-made WAI middleware (here: the request body size limit).
    , wai-extra

-- The program you run: "cabal run ledger-api". Its main function is in
-- app/Main.hs.
executable ledger-api
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  -- -threaded uses the multi-core runtime, and -N runs it on every CPU
  -- core, so the web server handles requests in parallel. Without -N it
  -- runs on one core, and each ~50 ms password check would pause every
  -- other request.
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      double-entry-ledger
    , warp

-- A second program: "cabal run ledger-seed" adds demo data to the database
-- at DATABASE_URL. Kept out of the API server, so a server can never put
-- demo money into a real database by accident.
executable ledger-seed
  import:           shared
  hs-source-dirs:   seed
  main-is:          Main.hs
  build-depends:
      double-entry-ledger

-- The test suite: "cabal test". test/Spec.hs is generated by hspec-discover,
-- which finds every *Spec module listed below.
test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  -- Every test module must be listed, like exposed-modules for the library.
  other-modules:
      Ledger.AppSpec
      Ledger.AuthSpec
      Ledger.CoreSpec
      Ledger.InvariantsSpec
      Ledger.MigrationsSpec
      Ledger.MoneySpec
      Ledger.SeedSpec
      Ledger.SessionSpec
      Ledger.Store.PostgresSpec
      Ledger.StoreSpec
      Ledger.ThrottleSpec
      Ledger.UserStoreSpec
      Ledger.ValidateSpec
      Support.Fixtures
      Support.Generators
      Support.StoreContract
      Support.UserStoreContract
  -- -N runs on all CPU cores, which the concurrency tests rely on.
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  -- A program (not a library) needed while building: the tool that
  -- generates test/Spec.hs's main.
  build-tool-depends:
      hspec-discover:hspec-discover
  build-depends:
      double-entry-ledger
    , async
    , directory
    , hspec
    -- Sends requests straight to the web app in tests, without a server.
    , hspec-wai
    , http-types
    , postgresql-simple
    , QuickCheck
    , resource-pool
    , time
    , wai
    , wai-extra
