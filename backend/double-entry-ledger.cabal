cabal-version:      3.0
name:               double-entry-ledger
version:            0.1.0.0
build-type:         Simple

-- Temporary minimal version so the editor can type-check while you work
-- through Steps 4-5. Replace this whole file with the tutorial's version in
-- Step 6. Add each new module to exposed-modules as you create it.
library
  default-language: Haskell2010
  ghc-options:      -Wall
  hs-source-dirs:   src
  exposed-modules:
      Ledger.Money
      Ledger.Types
  build-depends:
      base >=4.14 && <5
    , aeson >=2.0
    , text
